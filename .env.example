# Salin file ini menjadi .env, lalu ganti POSTGRES_PASSWORD dengan password acak.
# File .env tidak di-commit (lihat .gitignore). File contoh ini di-commit.
# Pakai huruf dan angka saja untuk password, supaya aman dipakai di connection string nanti.
POSTGRES_USER=revioten
POSTGRES_PASSWORD=ganti-dengan-password-acak
POSTGRES_DB=revioten

# Port di komputer Anda. Ganti bila 5432 sudah dipakai PostgreSQL lain.
POSTGRES_PORT=5432
