# Salin file ini menjadi .env, lalu ganti POSTGRES_PASSWORD dan APP_DB_PASSWORD dengan password acak.
# File .env tidak di-commit (lihat .gitignore). File contoh ini di-commit.
# Pakai huruf dan angka saja untuk password, supaya aman dipakai di connection string nanti.
POSTGRES_USER=revioten
POSTGRES_PASSWORD=ganti-dengan-password-acak
POSTGRES_DB=revioten

# Port di komputer Anda. Ganti bila 5432 sudah dipakai PostgreSQL lain.
POSTGRES_PORT=5432

# Password role database aplikasi revioten_app (M1.3, E-06). Server memakai
# role ini untuk semua operasi, dan role ini tidak bisa mengubah atau menghapus
# audit log. Program memasang password ini ke PostgreSQL setiap kali mulai.
# Huruf dan angka saja, 16 sampai 128 karakter. Contoh di bawah sengaja ditolak.
APP_DB_PASSWORD=ganti-dengan-huruf-dan-angka-acak

# Backup terenkripsi (M1.7). Dipakai perintah `revioten backup` dan `restore`,
# tidak wajib untuk server.
# BACKUP_DIR: folder tujuan backup, sebaiknya di disk lain (disk eksternal atau
# partisi lain), misalnya D:/backup-revioten. Folder harus sudah ada.
# BACKUP_PASSPHRASE: paling sedikit 15 karakter. Simpan salinannya di tempat
# lain (pengelola password atau kertas di tempat aman): tanpa passphrase ini,
# backup tidak bisa dibuka lagi.
BACKUP_DIR=
BACKUP_PASSPHRASE=

# Lampiran perubahan (M5.2). Folder privat tempat berkas lampiran disimpan
# dengan nama SHA-256 isinya. Kosong berarti data/attachments (tidak di-commit).
# Perintah backup ikut mengarsipkan folder ini terenkripsi (D-163).
ATTACHMENT_DIR=

# Cetak (Tahap 6). PDF dibuat dengan Chrome atau Edge yang sudah terpasang.
# PDF_BROWSER: lokasi browser bila tidak ditemukan otomatis, misalnya
# C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe. Kosong berarti dicari.
PDF_BROWSER=
# PUBLIC_BASE_URL: alamat aplikasi di QR cetakan (bila QR dinyalakan di Settings),
# misalnya http://192.168.1.10:8080 supaya bisa dibuka dari HP di jaringan yang sama.
PUBLIC_BASE_URL=

# Pemindai antivirus untuk unggahan (M8.2). Alamat daemon clamd, misalnya
# 127.0.0.1:3310. Kosong berarti unggahan tidak dipindai (server memberi
# peringatan saat mulai). Bila diisi tetapi pemindai mati, unggahan ditolak.
CLAMAV_ADDR=

# Deploy lokal dengan Docker Compose (M8.3, compose.deploy.yaml).
# HTTPS_PORT: port HTTPS di komputer ini; kosong berarti 8443.
# DEPLOY_CLAMAV_ADDR: isi clamav:3310 bila profil clamav dinyalakan.
HTTPS_PORT=
DEPLOY_CLAMAV_ADDR=

# API integrasi (Tahap 9). Batas permintaan per token per menit; kosong berarti 120.
INTEGRATION_RATE_PER_MINUTE=

# Email notifikasi (D-194). Diisi tim IT. Kosongkan MAIL_PROVIDER bila email
# belum dipakai: email tetap tercatat di Admin > Notifications, tetapi tidak dikirim.
# MAIL_PROVIDER: graph (Microsoft Graph, disarankan untuk Microsoft 365),
#                smtp (misalnya smtp.office365.com atau relay Exchange internal),
#                atau log (tidak dikirim, hanya ditulis ke log server; untuk demo).
# MAIL_FROM: kotak surat pengirim, misalnya revioten@perusahaan.co.id.
MAIL_PROVIDER=
MAIL_FROM=
# Untuk MAIL_PROVIDER=graph: app registration di Microsoft Entra ID dengan izin
# aplikasi Mail.Send (sebaiknya dibatasi ke kotak surat MAIL_FROM saja).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Untuk MAIL_PROVIDER=smtp. SMTP_PORT bawaan 587, SMTP_STARTTLS bawaan true.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=
