{
	"name": "revioten-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"gen:api": "svelte-kit sync && openapi-ts",
		"test:e2e": "vite build && playwright test",
		"tour": "vite build && playwright test --config playwright.tour.config.ts",
		"help:shots": "vite build && playwright test --config playwright.help.config.ts"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@hey-api/openapi-ts": "0.99.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@types/tabulator-tables": "6.3.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tabulator-tables": "6.7.1",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.22.1 <25"
	}
}
