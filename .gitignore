# Sejak D-152 data asli boleh di-commit ke repo private ini (misalnya di
# docs/referensi/). Folder data/ tetap tidak di-commit, untuk file besar atau
# sementara yang memang tidak perlu ada di GitHub.
/data/

# Catatan belajar pribadi pemilik (panduan pemula, status, catatan sesi).
# Hanya untuk komputer pemilik, tidak di-upload ke GitHub.
/catatan-pribadi/

# Rahasia lokal (password database dan sejenisnya). Contohnya ada di .env.example.
.env
.env.*
!.env.example

# Hasil build Go
bin/
dist/
*.exe
*.test
*.out

# Dependensi dan hasil build frontend (Node, SvelteKit, Vitest, Playwright)
node_modules/
build/
# Folder web/build/ di-commit hanya berisi .gitkeep, supaya go:embed di web/web.go
# selalu menemukan folder ini walaupun frontend belum di-build (M0.4).
!web/build/
web/build/*
!web/build/.gitkeep
.svelte-kit/
vite.config.ts.timestamp-*
# Log yang ditulis @hey-api/openapi-ts bila kontrak gagal dibaca saat gen:api.
openapi-ts-error-*.log
coverage/
test-results/
playwright-report/

# File sistem operasi dan pengaturan editor pribadi
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
