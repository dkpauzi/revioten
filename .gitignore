# Dokumen asli perusahaan dan customer (D-29). Sampai R-SEC-08 diputuskan,
# dokumen asli hanya disimpan di folder data/ dan tidak pernah di-commit.
/data/

# Rahasia lokal (password database dan sejenisnya). Contohnya ada di .env.example.
.env
.env.*
!.env.example

# Hasil build Go
bin/
dist/
*.exe
*.test
*.out

# Dependensi dan hasil build frontend (Node, SvelteKit, Vitest, Playwright)
node_modules/
build/
# Folder web/build/ di-commit hanya berisi .gitkeep, supaya go:embed di web/web.go
# selalu menemukan folder ini walaupun frontend belum di-build (M0.4).
!web/build/
web/build/*
!web/build/.gitkeep
.svelte-kit/
vite.config.ts.timestamp-*
# Log yang ditulis @hey-api/openapi-ts bila kontrak gagal dibaca saat gen:api.
openapi-ts-error-*.log
coverage/
test-results/
playwright-report/

# File sistem operasi dan pengaturan editor pribadi
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
