@startuml U8-C-dokumen-perubahan-rute
hide circle
hide empty members
skinparam linetype ortho
skinparam shadowing false
skinparam ArrowColor #444444
skinparam ClassBorderColor #1F4E79
skinparam ClassBackgroundColor #FFFFFF

title U8-C · Jenis dokumen, master perubahan, jabatan, dan rute approval (migrasi 00007 sampai 00009)

entity "document_types" as document_types {
  * id : uuid <<PK>>
  --
  key : text <<UK>>
  * name : text
  * letter : text <<UK>>
  * position : smallint
}

entity "special_codes" as special_codes {
  * id : uuid <<PK>>
  --
  * code : text <<UK>>
  * name : text
  * created_at : timestamptz
}

entity "change_types" as change_types {
  * id : uuid <<PK>>
  --
  * key : text <<UK>>
  * name : text
  * position : smallint
  approval_route_id : uuid <<FK>>
}

entity "change_sources" as change_sources {
  * id : uuid <<PK>>
  --
  * name : text
  mechanism : text <<UK>>
  * active : boolean = true
  * created_at : timestamptz
}

entity "four_m_categories" as four_m_categories {
  * id : uuid <<PK>>
  --
  * key : text <<UK>>
  * name : text
  * position : smallint
}

entity "positions" as positions {
  * id : uuid <<PK>>
  --
  * key : text <<UK>>
  * name : text
  * per_project_group : boolean
  * single_holder : boolean = false
  * sort_order : smallint
}

entity "position_holders" as position_holders {
  * id : uuid <<PK>>
  --
  * position_id : uuid <<FK>>
  * per_project_group : boolean <<FK>>
  * person_id : uuid <<FK>>
  project_group_id : uuid <<FK>>
  * created_at : timestamptz
}

entity "approval_routes" as approval_routes {
  * id : uuid <<PK>>
  --
  * name : text
  * created_at : timestamptz
}

entity "route_slots" as route_slots {
  * id : uuid <<PK>>
  --
  * route_id : uuid <<FK>>
  * slot_order : smallint
  * stage : text
  * print_title : text
}

entity "route_slot_positions" as route_slot_positions {
  * slot_id : uuid <<PK, FK>>
  * position_id : uuid <<PK, FK>>
}

entity "system_settings" as system_settings {
  * id : uuid <<PK>>
  --
  * sign_dates_enabled : boolean = false
}

entity "people" as people_c {
  * id : uuid <<PK>>
}

entity "project_groups" as project_groups_c {
  * id : uuid <<PK>>
}

entity "customers" as customers_c {
