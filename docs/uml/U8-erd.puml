@startuml U8-B-akses-dan-audit
hide circle
hide empty members
skinparam linetype ortho
skinparam shadowing false
skinparam ArrowColor #444444
skinparam ClassBorderColor #1F4E79
skinparam ClassBackgroundColor #FFFFFF

title U8-B · Orang, akun, hak akses, dan audit log (migrasi 00002 sampai 00004)

entity "people" as people {
  * id : uuid <<PK>>
  --
  * name : text
  employee_number : text <<UK>>
  * created_at : timestamptz
}

entity "accounts" as accounts {
  * id : uuid <<PK>>
  --
  * person_id : uuid <<FK>>
  * kind : text
  * login : text <<UK>>
  * password_hash : text
  * must_change_password : boolean = false
  * failed_logins : integer = 0
  locked_until : timestamptz
  disabled_at : timestamptz
  external_id : text <<UK>>
  * created_at : timestamptz
}

entity "sessions" as sessions {
  * token_hash : bytea <<PK>>
  --
  * account_id : uuid <<FK>>
  * created_at : timestamptz
  * last_seen_at : timestamptz
  * expires_at : timestamptz
}

entity "permissions" as permissions {
  * code : text <<PK>>
  --
  * level : text
  * sort_order : integer
}

entity "roles" as roles {
  * id : text <<PK>>
  --
  * level : text
  * sort_order : integer
}

entity "role_permissions" as role_permissions {
  * role_id : text <<PK, FK>>
  * permission_code : text <<PK, FK>>
}

entity "account_roles" as account_roles {
  * account_id : uuid <<PK, FK>>
  * role_id : text <<PK, FK>>
  --
  * scope : text = 'all'
}

entity "audit_log" as audit_log {
  * seq : bigint <<PK>>
  --
  * occurred_at : timestamptz
  * actor_type : text
  actor_account_id : uuid <<FK>>
  actor_person_id : uuid <<FK>>
  request_id : text
  source_ip : text
  * action : text
  target_type : text
  target_id : uuid
  * details : text
  * prev_hash : text
  * hash : text <<UK>>
}

people ||--o{ accounts
accounts ||--o{ sessions
roles ||--o{ role_permissions
permissions ||--o{ role_permissions
accounts ||--o{ account_roles
roles ||--o{ account_roles
accounts |o--o{ audit_log
people |o--o{ audit_log

note right of accounts
  kind: work atau admin (D-72). UNIQUE (person_id, kind):
  satu orang paling banyak satu akun kerja dan satu akun
  admin (D-79). login: ^[a-z0-9._-]{3,64}$ (D-85).
  password_hash: argon2id format PHC; password asli
  tidak pernah disimpan (R-SEC-14).
  Tidak pernah dihapus, hanya disabled_at (D-105).
end note

note bottom of sessions
  Hanya hash SHA-256 token; token asli di cookie.
  Batas diam dan batas mutlak sesi (D-85).
  Satu-satunya tabel yang boleh DELETE (logout).
end note

note bottom of account_roles
  scope: all atau own_project_group (D-71, D-82).
  Katalog hak (permissions) tetap; isi peran
  (role_permissions) diatur admin (D-66).
end note

note right of audit_log
  Append-only (R-SEC-03):
  - role aplikasi hanya SELECT dan INSERT;
  - trigger menolak UPDATE, DELETE, TRUNCATE;
  - seq tanpa lubang, dibagikan aplikasi di bawah
    advisory lock rantai, bukan sequence (E-06);
  - hash = SHA-256(prev_hash + isi), satu rantai
    untuk seluruh sistem (D-83).
  actor_type: human, system, anonymous (D-106);
  human selalu punya akun dan orang.
  details: teks JSON, bukan jsonb, supaya byte yang
  di-hash sama dengan yang disimpan.
end note
@enduml

