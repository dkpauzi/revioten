  kind : wi | sop | qep | lainnya
  decision : affected | not_affected
}

class Revision {
  revision : Bilangan (-00, -01, ...)
  status : draft | released
  snapshot : isi beku
  sha256 : Teks
  releaseDate : Tanggal
  scan : scan bertanda tangan
  migrated : Ya/Tidak
}

class Yokoten {
  ref : YKT-nnnn
