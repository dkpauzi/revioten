  revokedAt : Waktu
}

class Proposal {
  baseRevision : revisi berlaku yang dibaca
  sourceApplication : Teks
  onBehalfOf : Teks, hanya dicatat (R-API-09)
  operations : add | modify | remove, boleh kosong
}

class ExportJob {
  status : queued | running | done | failed
  file : Excel
}

class NotificationEvent {
  key : change_submitted, change_verified,\n  release_ready, revision_released, ...
  enabled : Ya/Tidak
}

class OutboxEmail {
  subject, body : Teks
  status : pending | sending | sent | failed | skipped
  attempts : Bilangan
}

class Customer <<lihat U5-A>>
class Person <<lihat U5-B>> {
  email : boleh kosong
}
class Document <<lihat U5-F>>
class Change <<lihat U5-G>>

ServiceAccount "*" -- "1..*" Customer : hanya customer ini >
ServiceAccount "1" *-- "0..*" Token
ServiceAccount "1" -- "0..*" Proposal
Proposal "1" -- "1" Change : mechanism integration >
Proposal "*" -- "1" Document
ServiceAccount "1" -- "0..*" ExportJob
ExportJob "*" -- "1" Document
NotificationEvent "1" -- "0..*" OutboxEmail
