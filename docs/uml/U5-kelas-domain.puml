  ownerTeam, contact, purpose : Teks
  scopes : documents:read, revisions:read,\n  changes:read, changes:propose, exports:create
  networks : CIDR, boleh kosong
  disabled : Ya/Tidak
}

class Token {
  prefix : Teks (bukan rahasia)
  hash : SHA-256 (nilainya tidak disimpan)
